.vscode/**
.vscode-test/**
src/**
.gitignore
.env
.env.*
!.env.example
tsconfig.json
**/*.ts
**/*.map
out/test/**
pnpm-lock.yaml
.nvmrc
.node-version
.npmrc
docs/**
scripts/**
.tmp/**
.bin-all-backup/**
webview/node_modules/**
packages/**
# Exclude most node_modules since we bundle
node_modules/**
# But include @cursor/sdk and its dependencies (external in bundle)
!node_modules/@cursor/**
!node_modules/sqlite3/**
!node_modules/@mapbox/**
!node_modules/node-addon-api/**
!node_modules/node-gyp-build/**
!node_modules/zod/**
!node_modules/@bufbuild/**
!node_modules/@connectrpc/**
!node_modules/@statsig/**
# Ensure bundled SQLite binaries are included in the VSIX
!bin/**
# Webview bundle (Phase 3)
!webview-dist/**
# Extension icons only (README screenshots stay out of the VSIX)
images/**
!images/logo.svg
