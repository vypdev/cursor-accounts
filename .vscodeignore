.vscode/**
.vscode-test/**
src/**
.gitignore
.env
.env.*
!.env.example
tsconfig.json
**/*.ts
**/*.map
out/test/**
pnpm-lock.yaml
.nvmrc
.node-version
.npmrc
docs/**
scripts/**
.tmp/**
.tmp-proto-test/**
.repowise/**
graphify-out/**
coverage/**
.build-backup/**
.bin-all-backup/**
webview/**
packages/**
**/test/**
**/tests/**
**/example/**
**/examples/**
**/README*
**/CHANGELOG*
**/*.md
**/*.markdown
**/*.map
:memory:*
*.db
*.db-*
typedoc.json
skills-lock.json
pnpm-workspace.yaml
eslint.config.mjs
# Production node_modules included in full (@cursor/sdk and all transitive deps)
# Root devDependencies stay on disk for build but are excluded from the VSIX
node_modules/@eslint/**
node_modules/@types/**
node_modules/@vscode/**
node_modules/esbuild/**
node_modules/eslint/**
node_modules/eslint-plugin-react-hooks/**
node_modules/globals/**
node_modules/typescript/**
node_modules/typescript-eslint/**
# Hoisted webview devDependencies (not part of @cursor/sdk runtime tree)
node_modules/vitest/**
node_modules/vite/**
node_modules/@vitest/**
node_modules/@testing-library/**
node_modules/jsdom/**
# Ensure bundled SQLite binaries are included in the VSIX
!bin/**
# Webview bundle (Phase 3)
!webview-dist/bundle.js
!webview-dist/bundle.css
webview-dist/*.map
# Protobuf schemas for MITM decode (runtime + packaged extension)
proto/**
# Extension icons only (README screenshots stay out of the VSIX)
images/**
!images/icon.png
